# Samo's local Minimax API configuration
#
# Copy or merge this file into `.env.local` in the same directory.
# Never commit `.env.local` or replace placeholders in this example file.
#
# MINIMAX_USERNAME and MINIMAX_PASSWORD are credentials created in Minimax under:
# Moj profil -> Urejanje osnovnih podatkov -> Gesla za dostop zunanjih aplikacij.

# Shared Minimax API client credentials used by the Apnea.si integration
MINIMAX_CLIENT_ID=REPLACE_ME_MINIMAX_CLIENT_ID
MINIMAX_CLIENT_SECRET=REPLACE_ME_MINIMAX_CLIENT_SECRET

# External-application credentials linked to the existing Minimax user
MINIMAX_USERNAME=REPLACE_ME_MINIMAX_USERNAME
MINIMAX_PASSWORD=REPLACE_ME_MINIMAX_PASSWORD

# Minimax SI endpoints
MINIMAX_API_BASE=https://moj.minimax.si/si/api
MINIMAX_AUTH_URL=https://moj.minimax.si/si/aut/oauth20/token

# SD Apnea Slovenija organisation and invoice configuration
MINIMAX_TRAINING_ORGANISATION_ID=REPLACE_ME_ORGANISATION_ID
MINIMAX_TRAINING_DOCUMENT_NUMBERING_ID=REPLACE_ME_DOCUMENT_NUMBERING_ID
MINIMAX_TRAINING_PAYMENT_METHOD_ID=REPLACE_ME_PAYMENT_METHOD_ID
MINIMAX_TRAINING_CASH_REGISTER_ID=
MINIMAX_TRAINING_REVENUE_ID=
MINIMAX_TRAINING_EMPLOYEE_ID=
MINIMAX_TRAINING_CURRENCY_ID=REPLACE_ME_CURRENCY_ID
MINIMAX_TRAINING_REPORT_TEMPLATE_ID=REPLACE_ME_REPORT_TEMPLATE_ID
MINIMAX_TRAINING_VAT_RATE_ID=
MINIMAX_TRAINING_VAT_RATE_PERCENTAGE_ID=
MINIMAX_TRAINING_CUSTOMER_COUNTRY_ID=192

# Safe local defaults: authentication and read-only API checks work while live
# invoice creation stays disabled. Do not change this to true merely to test access.
MINIMAX_TRAINING_INVOICING_ENABLED=false
MINIMAX_TRAINING_VAT_PERCENT=0
MINIMAX_TRAINING_ITEM_CODE=APNEA-CLANARINA
MINIMAX_TRAINING_RECORD_PAYMENT=false
MINIMAX_TRAINING_INVOICE_ACTION=generatepdf
MINIMAX_TRAINING_REQUIRE_PDF=true

# Fallback customer data used only by explicit test flows
MINIMAX_TRAINING_TEST_CUSTOMER_ADDRESS=REPLACE_ME_TEST_CUSTOMER_ADDRESS
MINIMAX_TRAINING_TEST_CUSTOMER_POSTAL_CODE=REPLACE_ME_TEST_CUSTOMER_POSTAL_CODE
MINIMAX_TRAINING_TEST_CUSTOMER_CITY=REPLACE_ME_TEST_CUSTOMER_CITY
